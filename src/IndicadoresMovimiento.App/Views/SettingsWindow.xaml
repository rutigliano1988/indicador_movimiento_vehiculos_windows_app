<Window x:Class="IndicadoresMovimiento.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Indicadores de movimiento: ajustes"
        Width="580" Height="780" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="_Restablecer valores" Click="OnReset" Style="{StaticResource SecondaryButton}" />
                <Button DockPanel.Dock="Right" Content="_Cerrar" Click="OnClose" IsCancel="True" Style="{StaticResource PrimaryButton}" />
                <Button DockPanel.Dock="Right" Content="_Salir de la aplicación" Click="OnExitApplication" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,18,20,22">
                <TextBlock Text="Indicadores de movimiento" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource Help}" FontSize="14" Margin="0,4,0,4"
                           Text="Unos puntos en los bordes de la pantalla se mueven con el vehículo para que lo que ves coincida con lo que notas, y así marearte menos al usar el ordenador en el coche." />

                <!-- Estado -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <Ellipse x:Name="StatusLight" Width="12" Height="12" Margin="0,0,10,0"
                                     VerticalAlignment="Center" Fill="{StaticResource IdleBrush}" />
                            <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Help}" Margin="22,4,0,0" />
                        <TextBlock x:Name="Readings" Style="{StaticResource Help}" Margin="22,2,0,0" />
                        <CheckBox x:Name="EnabledBox" Margin="0,12,0,0" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged">
                            <TextBlock x:Name="EnabledText" Text="Mostrar los indicadores" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Fuente -->
                <TextBlock Text="De dónde sale el movimiento" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ComboBox x:Name="SourceBox" SelectionChanged="OnSourceChanged" AutomationProperties.Name="Fuente del movimiento">
                            <ComboBoxItem Tag="Automatic" Content="Automática (recomendada)" />
                            <ComboBoxItem Tag="BuiltInSensor" Content="Sensor del ordenador" />
                            <ComboBoxItem Tag="Phone" Content="Móvil conectado por Wi-Fi" />
                            <ComboBoxItem Tag="Demo" Content="Demostración (movimiento simulado)" />
                        </ComboBox>
                        <TextBlock x:Name="SourceHelp" Style="{StaticResource Help}" Margin="0,8,0,0" />
                        <Button Content="Usar el _móvil como sensor…" Click="OnPhone" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Border>

                <!-- Cuándo -->
                <TextBlock Text="Cuándo mostrar los puntos" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <RadioButton x:Name="ModeAutomatic" GroupName="Mode" Checked="OnModeChanged">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Automático" /><LineBreak />
                                <Run Foreground="{StaticResource MutedBrush}" Text="Aparecen al detectar el movimiento del vehículo y desaparecen al parar." />
                            </TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="ModeAlways" GroupName="Mode" Margin="0,10,0,0" Checked="OnModeChanged">
                            <TextBlock TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="Siempre" /><LineBreak />
                                <Run Foreground="{StaticResource MutedBrush}" Text="Siempre visibles mientras estén activados." />
                            </TextBlock>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Apariencia -->
                <TextBlock Text="Apariencia" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="40" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tamaño de los puntos" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="DotSizeSlider" Minimum="4" Maximum="28"
                                SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="OnAppearanceChanged" AutomationProperties.Name="Tamaño de los puntos" />
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="DotSizeValue" Style="{StaticResource FieldValue}" />

                        <TextBlock Grid.Row="1" Text="Separación" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="SpacingSlider" Minimum="30" Maximum="200"
                                SmallChange="2" LargeChange="10" TickFrequency="2" IsSnapToTickEnabled="True"
                                ValueChanged="OnAppearanceChanged" AutomationProperties.Name="Separación entre puntos" />
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="SpacingValue" Style="{StaticResource FieldValue}" />

                        <TextBlock Grid.Row="2" Text="Opacidad" Style="{StaticResource FieldLabel}" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="OpacitySlider" Minimum="0.2" Maximum="1"
                                SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="OnAppearanceChanged" AutomationProperties.Name="Opacidad de los puntos" />
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="OpacityValue" Style="{StaticResource FieldValue}" />

                        <TextBlock Grid.Row="3" Text="Filas de puntos" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ColumnsBox" VerticalAlignment="Center"
                                  SelectionChanged="OnAppearanceChanged" AutomationProperties.Name="Filas de puntos en cada borde">
                            <ComboBoxItem Tag="1" Content="1 por borde" />
                            <ComboBoxItem Tag="2" Content="2 por borde" />
                            <ComboBoxItem Tag="3" Content="3 por borde" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Text="Color" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ColorBox" VerticalAlignment="Center"
                                  SelectionChanged="OnAppearanceChanged" AutomationProperties.Name="Color de los puntos">
                            <ComboBoxItem Tag="Automatic" Content="Gris con borde blanco (se ve sobre cualquier fondo)" />
                            <ComboBoxItem Tag="White" Content="Blanco" />
                            <ComboBoxItem Tag="Black" Content="Negro" />
                            <ComboBoxItem Tag="Blue" Content="Azul" />
                        </ComboBox>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,6,0,0">
                            <CheckBox x:Name="SideEdgesBox" Content="En los bordes izquierdo y derecho" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                            <CheckBox x:Name="TopBottomEdgesBox" Content="En los bordes superior e inferior" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                            <CheckBox x:Name="AllMonitorsBox" Content="En todas las pantallas (si hay más de una)" Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Movimiento -->
                <TextBlock Text="Movimiento" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sensibilidad" Style="{StaticResource FieldLabel}" />
                            <Slider Grid.Column="1" x:Name="SensitivitySlider" Minimum="0.25" Maximum="3"
                                    SmallChange="0.05" LargeChange="0.25" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnMotionChanged" AutomationProperties.Name="Sensibilidad" />
                            <TextBlock Grid.Column="2" x:Name="SensitivityValue" Style="{StaticResource FieldValue}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Help}" Margin="0,4,0,6"
                                   Text="Cuánto se desplazan los puntos al acelerar, frenar o girar." />
                        <CheckBox x:Name="InvertLateralBox" Content="Invertir izquierda y derecha" Checked="OnMotionChanged" Unchecked="OnMotionChanged" />
                        <CheckBox x:Name="InvertLongitudinalBox" Content="Invertir delante y detrás" Checked="OnMotionChanged" Unchecked="OnMotionChanged" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0"
                                   Text="Los puntos deben ir hacia donde te empuja el vehículo: hacia abajo al acelerar, hacia arriba al frenar y hacia fuera de la curva. Si van al revés (por ejemplo, si viajas de espaldas a la marcha), marca estas casillas." />
                    </StackPanel>
                </Border>

                <!-- Sistema -->
                <TextBlock Text="Sistema" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="StartWithWindowsBox" Content="Abrir al iniciar sesión en Windows" Checked="OnSystemChanged" Unchecked="OnSystemChanged" Margin="0" />
                        <CheckBox x:Name="HideFromCaptureBox" Content="Ocultar los puntos al compartir la pantalla o grabarla" Checked="OnSystemChanged" Unchecked="OnSystemChanged" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,6,0,0"
                                   Text="Así no aparecen en videollamadas (Teams, Zoom, Meet...) ni en capturas de pantalla. Requiere Windows 10 versión 2004 o posterior." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
