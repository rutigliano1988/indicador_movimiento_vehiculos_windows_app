<Window x:Class="IndicadoresMovimiento.App.Views.PhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usar el móvil como sensor"
        Width="820" Height="640" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBackground}"
                BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="_Cerrar" Click="OnClose" IsCancel="True"
                        Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" VerticalAlignment="Center" />
                <Ellipse x:Name="StatusLight" Width="12" Height="12" Margin="0,0,10,0"
                         VerticalAlignment="Center" Fill="{StaticResource IdleBrush}" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20,18,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
                    <TextBlock Text="Usar el móvil como sensor" Style="{StaticResource Title}" />
                    <TextBlock Style="{StaticResource Help}" FontSize="14" Margin="0,4,0,0"
                               Text="Si el ordenador no tiene sensor de movimiento, puede usar el del móvil a través de la red Wi-Fi. No hace falta instalar nada en el móvil: basta con abrir una página en su navegador." />
                </StackPanel>

                <!-- Código QR y dirección -->
                <StackPanel Grid.Row="1" Width="288" Margin="0,0,24,0">
                    <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="8">
                        <Grid Width="270" Height="270">
                            <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   AutomationProperties.Name="Código QR para abrir en el móvil" />
                            <TextBlock x:Name="QrPlaceholder" TextWrapping="Wrap" TextAlignment="Center"
                                       VerticalAlignment="Center" Margin="16" Style="{StaticResource Help}" FontSize="14" />
                        </Grid>
                    </Border>
                    <TextBlock Text="Red:" Margin="0,12,0,4" Style="{StaticResource Help}" />
                    <ComboBox x:Name="AddressBox" SelectionChanged="OnAddressChanged"
                              AutomationProperties.Name="Red por la que se conecta el móvil" />
                    <TextBlock Text="Enlace (si prefieres escribirlo o enviarlo):" Margin="0,10,0,4" Style="{StaticResource Help}" />
                    <TextBox x:Name="UrlBox" IsReadOnly="True" TextWrapping="Wrap" Padding="6,5"
                             FontFamily="Consolas, Segoe UI" AutomationProperties.Name="Enlace para el móvil" />
                    <Button x:Name="CopyButton" Content="Co_piar el enlace" Click="OnCopy" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" />
                </StackPanel>

                <!-- Instrucciones -->
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <Border Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="1. Misma red Wi-Fi" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0"
                                       Text="El móvil y el ordenador deben estar en la misma red. En el coche lo más fácil es conectar el ordenador al punto de acceso personal («Compartir internet») del propio móvil." />

                            <TextBlock FontWeight="SemiBold" Text="2. Escanea el código con la cámara del móvil" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0"
                                       Text="Y abre el enlace que aparece." />

                            <TextBlock FontWeight="SemiBold" Text="3. Acepta el aviso de seguridad" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0">
                                Es normal: la conexión va directamente del móvil a este ordenador con un certificado propio.
                                <LineBreak />• iPhone (Safari): «Mostrar detalles» → «visitar este sitio web» → «Visitar sitio web».
                                <LineBreak />• Android (Chrome): «Configuración avanzada» → «Acceder a … (sitio no seguro)».
                            </TextBlock>

                            <TextBlock FontWeight="SemiBold" Text="4. Pulsa «Empezar» y permite el acceso al movimiento" Margin="0,12,0,0" />

                            <TextBlock FontWeight="SemiBold" Text="5. Deja el móvil fijo y con la pantalla encendida" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0"
                                       Text="De pie en un soporte con la pantalla mirando hacia ti, o tumbado boca arriba con la parte de arriba hacia delante. Mejor si está cargando." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0" Background="#FFF8E1" BorderBrush="#F2D98B">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Help}" Foreground="#5F4B00">
                                <Run FontWeight="SemiBold" Text="¿No conecta?" />
                                Si Windows pregunta por el firewall, pulsa «Permitir acceso». Aun así, Windows suele tratar el
                                punto de acceso del móvil como red pública y puede bloquear la conexión si la aplicación se abrió
                                antes en otra red. Este botón lo arregla (pide permiso de administrador una vez):
                            </TextBlock>
                            <Button x:Name="FirewallButton" Content="Permitir la conexión del móvil en _cualquier red"
                                    Click="OnFirewall" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Style="{StaticResource SecondaryButton}" />
                            <TextBlock x:Name="FirewallResult" Style="{StaticResource Help}" Foreground="#5F4B00" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
