<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Permite compilar también desde Linux o macOS (p. ej. en integración continua). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>IndicadoresMovimiento</AssemblyName>
    <RootNamespace>IndicadoresMovimiento.App</RootNamespace>
    <AssemblyTitle>Indicadores de movimiento</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <!-- Es una aplicación WPF: el escalado por monitor se declara en app.manifest, que es lo que WPF necesita. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF y Windows Forms comparten nombres de tipos: solo se importan explícitamente. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndicadoresMovimiento.Core\IndicadoresMovimiento.Core.csproj" />
    <ProjectReference Include="..\IndicadoresMovimiento.Movil\IndicadoresMovimiento.Movil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets\app-pausa.ico" LogicalName="app-pausa.ico" />
  </ItemGroup>

</Project>
